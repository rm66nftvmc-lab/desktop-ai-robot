{
  "name": "dsh-plugin-session-delete",
  "version": "0.3.4",
  "description": "Delete-conversation plugin for DSH: a Session menu row that permanently removes one conversation through an authenticated Host route, plus bulk cleanup of unused blank Sessions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SereinHK/dsh-plugin-session-delete.git"
  },
  "homepage": "https://github.com/SereinHK/dsh-plugin-session-delete#readme",
  "bugs": {
    "url": "https://github.com/SereinHK/dsh-plugin-session-delete/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "bundle": "node tools/build.mjs",
    "test": "node --test \"tests/*.test.ts\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "delete"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  }
}
